{
  "routes": [
    { "route": "/", "rewrite": "/index.html" },
    { "route": "/demo", "redirect": "/demo/", "statusCode": 301 },
    { "route": "/demo/", "rewrite": "/demo/index.html" },
    { "route": "/privacy", "redirect": "/privacy/", "statusCode": 301 },
    { "route": "/privacy/", "rewrite": "/privacy/index.html" },
    { "route": "/terms", "redirect": "/terms/", "statusCode": 301 },
    { "route": "/terms/", "rewrite": "/terms/index.html" },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/relay-hero.webp", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/social-card.png", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/apple-touch-icon.png", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/favicon.svg", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/robots.txt" },
    { "route": "/sitemap.xml" },
    { "route": "/404", "rewrite": "/404.html", "statusCode": 404 },
    { "route": "/*", "rewrite": "/404.html", "statusCode": 404 }
  ],
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; form-action 'self'; frame-ancestors 'none'",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "X-Content-Type-Options": "nosniff"
  }
}
